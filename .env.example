# Base URL for on-demand CJK fonts (Noto Sans SC TTFs, ~10 MB each). Leave empty to disable.
NEXT_PUBLIC_CJK_FONT_BASE=https://cdn.jsdelivr.net/npm/@expo-google-fonts/noto-sans-sc@0.4.4
# Where tesseract.js downloads language data from.
NEXT_PUBLIC_TESSDATA_URL=https://tessdata.projectnaptha.com/4.0.0
